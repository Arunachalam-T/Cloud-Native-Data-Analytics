# ─────────────────────────────────────────────────────────────
# Cloud PostgreSQL — pick ONE option below and fill it in
# ─────────────────────────────────────────────────────────────

# Option A: Neon (free) → https://neon.tech
# DB_URL=jdbc:postgresql://<host>.neon.tech/<dbname>?sslmode=require
# DB_USERNAME=<your-neon-username>
# DB_PASSWORD=<your-neon-password>

# Option B: Supabase (free) → https://supabase.com
# DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# DB_USERNAME=postgres
# DB_PASSWORD=<your-supabase-password>

# Option C: AWS RDS → use your RDS endpoint
# DB_URL=jdbc:postgresql://<rds-endpoint>:5432/dataanalytics?sslmode=require
# DB_USERNAME=<rds-username>
# DB_PASSWORD=<rds-password>

# ── Paste your chosen values here ──
DB_URL=jdbc:postgresql://REPLACE_WITH_YOUR_HOST/REPLACE_WITH_YOUR_DB?sslmode=require
DB_USERNAME=REPLACE_WITH_USERNAME
DB_PASSWORD=REPLACE_WITH_PASSWORD

# ─────────────────────────────────────────────────────────────
# AWS S3 (for file storage)
# ─────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=data-analytics-dev-bucket

# ─────────────────────────────────────────────────────────────
# App Settings
# ─────────────────────────────────────────────────────────────
API_KEY=dev-secret-key-change-in-prod
SPRING_PROFILES_ACTIVE=dev

# JavaFX Frontend
API_BASE_URL=http://localhost:8080
